<Project>
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>    
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <NoWarn>1701;1702;IDE0130</NoWarn>
  </PropertyGroup>
</Project>